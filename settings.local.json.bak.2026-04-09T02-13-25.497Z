      "Bash(/Users/ganggyunggyu/Programing/local-image-llm/.venv/bin/python3 << 'PYEOF'\nfrom playwright.sync_api import sync_playwright\n\nwith sync_playwright\\(\\) as p:\n    browser = p.chromium.connect_over_cdp\\(\"http://127.0.0.1:18800\"\\)\n    context = browser.contexts[0]\n    page = context.pages[0]\n    \n    # Navigate to Instagram home\n    page.goto\\(\"https://www.instagram.com/\", wait_until=\"domcontentloaded\", timeout=15000\\)\n    page.wait_for_timeout\\(2000\\)\n    \n    # Click 만들기 \\(create\\)\n    create_btn = page.locator\\('a[href=\"#\"]:has-text\\(\"만들기\"\\), svg[aria-label=\"새로운 게시물\"]'\\).first\n    # Try a different approach - look for the sidebar link\n    links = page.locator\\('a'\\).all\\(\\)\n    for link in links:\n        text = link.inner_text\\(\\)\n        if \"만들기\" in text or \"새로운 게시물\" in text:\n            link.click\\(\\)\n            print\\(f\"Clicked: {text}\"\\)\n            break\n    \n    page.wait_for_timeout\\(2000\\)\n    \n    # Check if submenu appeared and click 게시물\n    post_links = page.locator\\('a'\\).all\\(\\)\n    for link in post_links:\n        text = link.inner_text\\(\\)\n        if text.strip\\(\\) == \"게시물\":\n            link.click\\(\\)\n            print\\(f\"Clicked submenu: {text}\"\\)\n            break\n    \n    page.wait_for_timeout\\(2000\\)\n    \n    # Now set the file on the hidden input\n    file_input = page.locator\\('input[type=\"file\"]'\\).first\n    file_input.set_input_files\\(\"/tmp/insta_upload.png\"\\)\n    print\\(\"File set successfully!\"\\)\n    \n    page.wait_for_timeout\\(3000\\)\n    print\\(\"Current URL:\", page.url\\)\n    print\\(\"Title:\", page.title\\(\\)\\)\n    \n    browser.close\\(\\)\nPYEOF)",
      "Bash(/Users/ganggyunggyu/Programing/local-image-llm/.venv/bin/python3 << 'PYEOF'\nfrom playwright.sync_api import sync_playwright\n\nwith sync_playwright\\(\\) as p:\n    browser = p.chromium.connect_over_cdp\\(\"http://127.0.0.1:18800\"\\)\n    context = browser.contexts[0]\n    \n    # List all pages\n    for i, pg in enumerate\\(context.pages\\):\n        print\\(f\"Page {i}: {pg.url}\"\\)\n    \n    page = context.pages[0]\n    print\\(f\"\\\\nUsing page: {page.url}\"\\)\n    print\\(f\"Title: {page.title\\(\\)}\"\\)\nPYEOF)",
      "Bash(/Users/ganggyunggyu/Programing/local-image-llm/.venv/bin/python3 << 'PYEOF'\nfrom playwright.sync_api import sync_playwright\n\nwith sync_playwright\\(\\) as p:\n    browser = p.chromium.connect_over_cdp\\(\"http://127.0.0.1:18800\"\\)\n    context = browser.contexts[0]\n    page = context.pages[2]\n    \n    print\\(f\"Using page: {page.url}\"\\)\n    \n    # Wait for dialog\n    page.wait_for_timeout\\(2000\\)\n    \n    # Check current dialog state\n    dialog = page.locator\\('div[role=\"dialog\"]'\\)\n    if dialog.count\\(\\) > 0:\n        print\\(f\"Dialog count: {dialog.count\\(\\)}\"\\)\n        h1 = page.locator\\('div[role=\"dialog\"] h1'\\)\n        if h1.count\\(\\) > 0:\n            print\\(f\"Dialog title: {h1.first.inner_text\\(\\)}\"\\)\n    \n    # Search for ALL input elements on the page\n    all_inputs = page.locator\\('input'\\).all\\(\\)\n    print\\(f\"\\\\nAll inputs found: {len\\(all_inputs\\)}\"\\)\n    for i, inp in enumerate\\(all_inputs\\):\n        try:\n            inp_type = inp.get_attribute\\('type', timeout=2000\\)\n            inp_accept = inp.get_attribute\\('accept', timeout=2000\\)\n            inp_visible = inp.is_visible\\(\\)\n            print\\(f\"  Input {i}: type={inp_type}, accept={inp_accept}, visible={inp_visible}\"\\)\n        except:\n            print\\(f\"  Input {i}: \\(error reading attributes\\)\"\\)\n    \n    # Also try to find form elements\n    forms = page.locator\\('form'\\).all\\(\\)\n    print\\(f\"\\\\nForms found: {len\\(forms\\)}\"\\)\nPYEOF)",
